# healthlog 的反代配置，由 crab 的 Caddyfile 通过 import /etc/caddy/sites/*.caddy 引入，
# 放在 crab 站点块里、兜底 404 之前。安装：sudo make caddy-install。
# 内容是站点块内的指令：不要写域名、全局选项，括号要配对。
# 容器名 healthlog-app 能解析，是因为 docker-compose.yml 让 app 加入了 crab 的网络。

redir /health /health/ 308

handle /health/* {
	# 照片 ≤10 MB、语音 ≤20 MB
	request_body {
		max_size 50MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Robots-Tag noindex
	}
	# 应用自己挂在 /health 下（BASE_PATH），路径原样转发，所以用 handle 而不是 handle_path
	reverse_proxy healthlog-app:8080
}
