# Copy to .env. The Makefile exports these for `make dev`; docker compose reads them in production.
# Never commit .env — it holds secrets.

HTTP_ADDR=:8080
DATABASE_URL=postgres://healthlog:healthlog@localhost:5432/healthlog?sslmode=disable
STORAGE_DIR=./data/storage
# Generate with: openssl rand -hex 32
SESSION_SECRET=
PRINT_TOKEN_SECRET=
GOTENBERG_URL=http://localhost:3000
# Origin users open in the browser. In dev that is the Vite server.
PUBLIC_BASE_URL=http://localhost:5173
TZ=Asia/Shanghai

# --- Production (deploy/docker-compose.yml) only ---
DOMAIN=health.example.com
POSTGRES_PASSWORD=
