# Copy to .env. `make dev` exports these; `docker compose` reads them in production.
# Never commit .env. Do not put comments at the end of a value line.

# ---------- Local development (make dev) ----------
HTTP_ADDR=:8080
DATABASE_URL=postgres://healthlog:healthlog@localhost:5432/healthlog?sslmode=disable
STORAGE_DIR=./data/storage
GOTENBERG_URL=http://localhost:3000
# Origin users open in the browser; in dev that is the Vite server. http:// turns off Secure cookies.
PUBLIC_BASE_URL=http://localhost:5173
# Where Gotenberg (in Docker) opens print pages: the Vite dev server on the host.
PRINT_BASE_URL=http://host.docker.internal:5173
# At least 32 characters: openssl rand -hex 32
PRINT_TOKEN_SECRET=
TZ=Asia/Shanghai
# Path prefix the app is served under. Leave empty in development; production defaults to /health.
BASE_PATH=
# Integration tests (make test-integration) run in throwaway schemas of this database.
TEST_DATABASE_URL=postgres://healthlog:healthlog@localhost:5432/healthlog?sslmode=disable

# ---------- Production (docker compose on the shared server) ----------
# Domain the gateway serves; healthlog lives at https://PUBLIC_DOMAIN/health/ (BASE_PATH).
PUBLIC_DOMAIN=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Build mirrors for mainland China; overseas: https://proxy.golang.org,direct and https://registry.npmjs.org
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
# Backups (scripts/backup.sh): optional age public key and rclone remote.
KEEP_DAYS=30
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=
